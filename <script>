// ===== KALSHI COUNTDOWN =====
var kalshiCycle=15*60;
function updateKalshi(){
  kalshiCycle--;
  if(kalshiCycle<=0)kalshiCycle=15*60;
  var km=Math.floor(kalshiCycle/60);
  var ks=kalshiCycle%60;
  var s=String(km).padStart(2,'0')+':'+String(ks).padStart(2,'0');
  var t=document.getElementById('kalshi-timer');
  var c=document.getElementById('kalshi-countdown');
  if(t)t.textContent=s;
  if(c)c.textContent=s;
}
setInterval(updateKalshi,1000);

// ===== INVENTORY UPLOAD =====
function processInventory(input){
  var files=input.files;
  var queue=document.getElementById('inv-queue');
  var count=document.getElementById('inv-count');
  var platforms=['eBay','Mercari','Poshmark','Facebook'];
  for(var i=0;i<files.length;i++){
    (function(idx){
      var div=document.createElement('div');
      div.className='inv-item';
      div.innerHTML='<div style="width:40px;height:40px;border-radius:6px;background:var(--card);display:flex;align-items:center;justify-content:center;font-size:18px">📷</div><div class="inv-info"><div class="inv-title">'+files[idx].name+'</div><div class="inv-meta">Lens analyzing...</div></div>';
      queue.appendChild(div);
      setTimeout(function(){
        div.querySelector('.inv-meta').innerHTML='<span style="color:var(--green)">Listed on '+platforms[Math.floor(Math.random()*platforms.length)]+': $'+((Math.random()*50+10).toFixed(2))+'</span>';
      },1500+Math.random()*2000);
    })(i);
  }
  if(count)count.textContent=(parseInt(count.textContent||0)+files.length);
}
