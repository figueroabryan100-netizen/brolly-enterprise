// ===== REAL BALANCES =====
function saveRealBalances(){
  var b={};
  ['kalshi','crypto','bank','cash','resell','pending'].forEach(function(k){
    var el=document.getElementById('bal-'+k);
    if(el)b[k]=parseFloat(el.value)||0;
  });
  localStorage.setItem('brolly_balances',JSON.stringify(b));
  calcTotals();
}
function loadRealBalances(){
  var b=localStorage.getItem('brolly_balances');
  if(b){
    try{
      b=JSON.parse(b);
      ['kalshi','crypto','bank','cash','resell','pending'].forEach(function(k){
        var el=document.getElementById('bal-'+k);
        if(el&&b[k]!==undefined)el.value=b[k].toFixed(2);
      });
      calcTotals();
    }catch(e){}
  }
}
